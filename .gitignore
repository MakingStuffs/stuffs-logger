node_modules/
.next/
dist/
build/
out/
coverage/
*.tsbuildinfo
.DS_Store

# env — EVERY variant, not a list of the ones someone thought of. The old
# list named `.env`, `.env*.local` and `.env.production`, which left
# `.env.development`, `.env.test` and `.env.e2e` trackable; one of those
# committed by accident carries the same secrets as the ones that were
# listed. The committed templates are re-included by name below.
.env*
!.env*.example

# registry auth
.npmrc

# test output
playwright-report/
test-results/
blob-report/
.vercel

# Playwright run state: one signed-in storage state per role, plus the seed
# manifest carrying that run's freshly minted ingest keys. Both are live
# credentials for the e2e database and neither is reproducible, so they are
# regenerated by the `seed` and `auth` setup projects on every run.
apps/dashboard/e2e/.state/

# pnpm falls back to a repository-local content-addressable store when it
# cannot write to the user-level one (sandboxes, locked-down CI images), so
# this directory appears on some machines and not others.
.pnpm-store/

# Claude Code's per-machine state. `settings.local.json` is one developer's
# local permission grants, and `.cc-writes/` is a session scratch area the
# tool creates next to files it edits (it has appeared under `.github/
# workflows/` as well as at the root). `.claude/` itself is NOT ignored:
# shared agent instructions and skills belong in the repository.
.claude/settings.local.json
**/.claude/.cc-writes/
