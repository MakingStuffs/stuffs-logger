{
  "name": "@stuffs-logger/dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && vitest run --passWithNoTests",
    "test:unit": "pnpm run test",
    "test:e2e": "node --env-file-if-exists=.env.e2e ./node_modules/@playwright/test/cli.js test --project=chromium",
    "test:e2e:report": "playwright show-report",
    "test:smoke": "node --env-file-if-exists=.env.e2e ./node_modules/@playwright/test/cli.js test --project=smoke",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "user:create-admin": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/register-src-resolver.mjs scripts/create-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@stuffs-logger/core": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "better-auth": "1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^30.1.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
