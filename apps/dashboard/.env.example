# Copy to .env.local for local development.
#
# NEVER put a real secret in this file — it is committed. Values here are empty
# placeholders and comments only.

# --- Database ----------------------------------------------------------------
# Postgres connection string used by the app at runtime. Point it at a pooled
# connection in production.
DATABASE_URL=

# The DIRECT (unpooled) connection, used only by `prisma migrate`. A transaction
# pooler cannot hold the advisory lock migrations take, so this must bypass it.
# Locally the two are usually the same value.
DIRECT_DATABASE_URL=

# --- Local development without the portal ------------------------------------
# DANGER: these two make getSession() return a mock INTERNAL_ADMIN session to
# EVERY visitor - no sign-in, full access to every application's logs, and the
# ability to mint and revoke ingest keys. They are commented out deliberately:
# this file is copied wholesale into deployment environments, and the installed
# isAuthSkipped() has no NODE_ENV guard of its own.
#
# Uncomment ONLY in .env.local, on your own machine. A production build refuses
# to boot with either set - see src/constants/environment.ts.
#
# NEXT_PUBLIC_ is needed alongside the plain variable because client bundles
# cannot read the plain one.
# SKIP_AUTH=true
# NEXT_PUBLIC_SKIP_AUTH=true

# --- Auth (required once SKIP_AUTH is off) -----------------------------------
# The portal origin, always — never this app's own URL. salient-auth v6 reads it
# for every call to ${portal}/api/auth/*, and it is where unauthenticated
# visitors are sent to sign in.
#
# This app runs in SUBDOMAIN mode: it is served on its own subdomain of the same
# parent domain as the portal, NOT behind the portal proxy. Cross-subdomain
# cookie SSO is what makes the shared session work, so both values must be the
# portal's origin and the two hosts must share a registrable parent domain.
BETTER_AUTH_URL=
NEXT_PUBLIC_BETTER_AUTH_URL=

# --- Cron --------------------------------------------------------------------
# The raw application API token (jfk_…) minted in the portal for this app's
# catalog entry. Vercel Cron sends it as `Authorization: Bearer <value>` to
# /api/cron/retention. Set it in the Vercel dashboard, never here.
CRON_SECRET=

# --- Optional ----------------------------------------------------------------
# Set to debug to trace getSession events when diagnosing SSO issues.
# SALIENT_AUTH_LOG_LEVEL=debug
