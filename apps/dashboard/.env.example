# Copy to .env.local for local development.
#
# NEVER put a real secret in this file — it is committed. Values here are empty
# placeholders and comments only.

# --- Database ----------------------------------------------------------------
# Postgres connection string used by the app at runtime. Point it at a pooled
# connection in production. The auth tables (users, sessions, accounts,
# verifications, api_tokens) live in this same database as the log tables.
DATABASE_URL=

# The DIRECT (unpooled) connection, used only by `prisma migrate`. A transaction
# pooler cannot hold the advisory lock migrations take, so this must bypass it.
# Locally the two are usually the same value.
DIRECT_DATABASE_URL=

# --- Local development without signing in ------------------------------------
# DANGER: these two make getSession() return a mock ADMIN session to EVERY
# visitor - no sign-in, full access to every application's logs, and the ability
# to mint and revoke ingest keys. They are commented out deliberately: this file
# is copied wholesale into deployment environments, and isAuthSkipped() has no
# NODE_ENV guard of its own.
#
# Uncomment ONLY in .env.local, on your own machine. A production build refuses
# to boot with either set - see src/constants/environment.ts.
#
# NEXT_PUBLIC_ is needed alongside the plain variable because client bundles
# cannot read the plain one.
# SKIP_AUTH=true
# NEXT_PUBLIC_SKIP_AUTH=true

# --- Auth (required once SKIP_AUTH is off) -----------------------------------
# The signing secret for session cookies. REQUIRED in production: the app
# refuses to start without it rather than fall back to a shared default that
# would let anyone mint a session. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# THIS APP'S OWN ORIGIN, e.g. https://logger.example.com - never a third party's.
# It is the base every /api/auth/* URL and every OAuth callback is built from.
# Leave it unset locally and the origin is derived from the request.
BETTER_AUTH_URL=

# --- Google sign-in (OPTIONAL) -----------------------------------------------
# Leave BOTH empty to run on email and password alone: the provider is only
# registered when the pair is complete, and the sign-in page only offers the
# button when it is. Setting one without the other is treated as "not
# configured" rather than as a half-working button.
#
# The authorised redirect URI to register with Google is:
#   ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cron --------------------------------------------------------------------
# The raw API token whose SHA-256 digest is a live row in `api_tokens`. Vercel
# Cron sends it as `Authorization: Bearer <value>` to /api/cron/retention. Set it
# in the Vercel dashboard, never here.
CRON_SECRET=

# --- Provisioning the first account ------------------------------------------
# There is no sign-up form, deliberately: any signed-in account reads every
# application's logs, so registration is not self-service. Create the first
# account against a running app with sign-up temporarily enabled in
# src/lib/auth/auth.ts, then set its role:
#   UPDATE users SET role = 'ADMIN' WHERE email = 'you@example.com';
# and turn sign-up back off. Deactivate a leaver with:
#   UPDATE users SET "isActive" = false WHERE email = 'them@example.com';
