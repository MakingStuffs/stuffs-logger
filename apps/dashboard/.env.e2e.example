# Copy to .env.e2e for local end-to-end runs.
#
# NEVER put a real secret in this file — it is committed. It is also a
# SEPARATE file from .env.example on purpose: the values below name a
# DISPOSABLE database that the suite truncates and reseeds on every run, and
# mixing them into the file that gets copied into a deployment is how a
# developer's database — or worse — gets emptied.
#
# `pnpm test:e2e` and `pnpm test:smoke` load this file automatically via
# Node's own `--env-file-if-exists`, so nothing needs to be exported by hand.
# Anything already in the environment wins, which is how CI supplies its own.

# --- The disposable e2e database ---------------------------------------------
# Bring one up with a single container (nothing else in this repo needs Docker):
#
#   docker run --rm -d --name stuffs-logger-e2e -p 5432:5432 \
#     -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=stuffs_logger_e2e postgres:17
#
# Or, against a Postgres you already run:
#
#   createdb stuffs_logger_e2e
#
# REQUIRED, AND THERE IS NO FALLBACK TO DATABASE_URL. The harness applies
# `prisma migrate deploy`, force-creates an ADMIN account whose password is a
# public literal in this repository, mints an ingest key and deletes the seeded
# application's log rows — so it will not accept a connection string that
# merely happened to be in the environment. DATABASE_URL is exported as a
# matter of course in containers, in CI, by direnv and on a server; naming the
# database HERE, in its own variable, is the explicit "this one is disposable".
#
# The name must also LOOK disposable: it has to contain `e2e` or `test` as a
# whole word, or the run is refused before anything is written. The harness
# also refuses to run at all under NODE_ENV=production.
E2E_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/stuffs_logger_e2e

# The direct (unpooled) connection `prisma migrate deploy` uses. Locally this
# is the same value; leave it unset and E2E_DATABASE_URL is used for both. It
# is held to the same naming rule, because it is the connection the migration
# actually runs against.
# E2E_DIRECT_DATABASE_URL=

# --- Where the suite points ---------------------------------------------------
# Leave UNSET and Playwright builds and starts the dashboard itself on
# http://127.0.0.1:3000. Setting it means "a server is already running there" —
# Playwright will not start one, and will not stop one.
# E2E_BASE_URL=http://127.0.0.1:3000

# The port the run-managed dashboard listens on. Move it when something else on
# your machine already holds 3000; the base URL every spec navigates against
# moves with it. Ignored when E2E_BASE_URL is set, because then nothing is
# being started.
# E2E_PORT=3000

# The smoke suite's target. REQUIRED by `pnpm test:smoke` and deliberately
# without a default: it is the one suite that runs against a deployed
# environment, so a wrong guess would report a healthy deployment nobody
# checked.
#
# SET E2E_BASE_URL ALONGSIDE IT when the target is a deployed origin:
#
#   E2E_BASE_URL=https://logger.example.com \
#     SMOKE_BASE_URL=https://logger.example.com pnpm test:smoke
#
# Playwright's managed web server is global to the config rather than per
# project, so without E2E_BASE_URL a smoke run also builds and starts a whole
# local dashboard it never visits. Setting it is how you say "the server is
# somebody else's".
# SMOKE_BASE_URL=https://logger.example.com

# --- Optional overrides -------------------------------------------------------
# Extra exact origins added to the seeded PUBLIC ingest key's allowlist, comma
# separated. The suite already allows both loopback spellings of E2E_BASE_URL;
# this is for a page served from somewhere else.
# E2E_SEED_ALLOWED_ORIGINS=https://example.test

# The seeded fixture accounts. Defaults are in e2e/support/fixtures.ts and are
# fine for a disposable database; override them only if the database this run
# points at is longer-lived than one CI job.
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# E2E_MEMBER_EMAIL=
# E2E_MEMBER_PASSWORD=

# The session-signing secret for the dashboard the harness starts. Left unset,
# a fresh random one is generated per run — which is what you want locally.
# Better Auth REFUSES to start with its built-in default under NODE_ENV=production,
# and `next start` is a production build, so this must never be empty on a
# server you run yourself.
# BETTER_AUTH_SECRET=
