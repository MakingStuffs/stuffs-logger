{
  "name": "stuffs-logger",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted logging platform: cross-platform TypeScript SDK plus a Next.js dashboard.",
  "license": "MIT",
  "author": "MakingStuffs",
  "homepage": "https://github.com/MakingStuffs/stuffs-logger#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MakingStuffs/stuffs-logger.git"
  },
  "bugs": {
    "url": "https://github.com/MakingStuffs/stuffs-logger/issues"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @stuffs-logger/dashboard dev",
    "lint": "eslint scripts && pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run && pnpm -r test",
    "test:unit": "pnpm run test",
    "test:e2e": "pnpm --filter @stuffs-logger/core --filter @stuffs-logger/sdk build && pnpm --filter @stuffs-logger/dashboard test:e2e",
    "test:smoke": "pnpm --filter @stuffs-logger/dashboard test:smoke",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "bash scripts/release.sh",
    "release:dry-run": "bash scripts/release.sh --dry-run",
    "release:verify-pack": "pnpm --filter @stuffs-logger/core --filter @stuffs-logger/sdk build && node scripts/verify-pack.mjs",
    "version:sync": "node scripts/sync-versions.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  }
}
