{
  "name": "@stuffs/logger",
  "version": "0.1.1",
  "description": "Cross-platform logging client for stuffs-logger: browser, Node and <script> builds with batching, redaction and console capture.",
  "keywords": [
    "logging",
    "logger",
    "observability",
    "error-tracking",
    "console",
    "browser",
    "node",
    "sdk",
    "stuffs-logger"
  ],
  "license": "MIT",
  "author": "MakingStuffs",
  "homepage": "https://github.com/MakingStuffs/stuffs-logger/tree/main/packages/logger-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MakingStuffs/stuffs-logger.git",
    "directory": "packages/logger-sdk"
  },
  "bugs": {
    "url": "https://github.com/MakingStuffs/stuffs-logger/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/stuffs-logger.global.js"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "browser": "./dist/browser.js",
  "unpkg": "./dist/stuffs-logger.global.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "import": {
          "types": "./dist/browser.d.ts",
          "default": "./dist/browser.js"
        },
        "require": {
          "types": "./dist/browser.d.cts",
          "default": "./dist/browser.cjs"
        }
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "require": {
        "types": "./dist/browser.d.cts",
        "default": "./dist/browser.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node ./scripts/build-global.mjs",
    "lint": "eslint . --config ../../eslint.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "node ./scripts/build-global.mjs"
  },
  "dependencies": {
    "@stuffs/logger-core": "workspace:*"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22"
  }
}
